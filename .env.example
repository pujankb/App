# APP_URL: Public URL where ASPD is hosted (injected automatically in AI Studio)
APP_URL="http://localhost:3000"

# Initial platform administrator email (granted admin role on first Google Sign-In)
ADMIN_EMAIL=""

# Optional server-side Admin ID and Passcode (overrides first-run claimed admin password)
ADMIN_ID=
ADMIN_PASSCODE=

# Cloud SQL PostgreSQL Runtime Variables (automatically provisioned and injected)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
